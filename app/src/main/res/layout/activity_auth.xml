<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/campus_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/authBrand" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/app_name"
            android:textSize="28sp" android:textStyle="bold" android:paddingBottom="12dp" />
        <TextView android:id="@+id/authTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/login_title"
            android:textSize="24sp" android:textStyle="bold" android:paddingBottom="12dp" />
        <TextView android:id="@+id/authIntro" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/auth_intro"
            android:paddingBottom="12dp" />
        <EditText android:id="@+id/authName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:hint="@string/full_name" android:inputType="textPersonName"
            android:autofillHints="name" android:singleLine="true" android:visibility="gone" />
        <EditText android:id="@+id/authEmail" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:hint="@string/email" android:inputType="textEmailAddress"
            android:autofillHints="emailAddress" android:singleLine="true" />
        <EditText android:id="@+id/authPassword" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:hint="@string/password" android:inputType="textPassword"
            android:importantForAutofill="no" android:singleLine="true" />
        <EditText android:id="@+id/authConfirmation" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:hint="@string/confirm_password" android:inputType="textPassword"
            android:importantForAutofill="no" android:singleLine="true" android:visibility="gone" />
        <TextView android:id="@+id/authError" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:visibility="gone"
            android:paddingTop="8dp" android:paddingBottom="8dp"
            android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/authProgress" android:layout_width="40dp"
            android:layout_height="40dp" android:layout_gravity="center_horizontal"
            android:visibility="gone" android:contentDescription="@string/loading" />
        <Button android:id="@+id/authSubmit" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/login_title" />
        <Button android:id="@+id/authSwitch" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/switch_register" />
        <Button android:id="@+id/authReset" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/reset_password" />
        <TextView android:id="@+id/authDemo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="@string/demo_accounts" />
    </LinearLayout>
</ScrollView>
