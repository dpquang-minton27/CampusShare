<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/campus_background" android:fillViewport="true" android:fitsSystemWindows="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:id="@+id/authBrand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="28sp" android:textColor="@color/campus_text" android:paddingBottom="12dp" android:textStyle="bold"/>
<TextView android:id="@+id/authTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/login_title" android:textSize="24sp" android:textColor="@color/campus_text" android:paddingBottom="12dp" android:textStyle="bold"/>
<TextView android:id="@+id/authIntro" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/auth_intro" android:textSize="16sp" android:textColor="@color/campus_text" android:paddingBottom="12dp" />
<EditText android:id="@+id/authName" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginBottom="12dp" android:hint="@string/full_name" android:inputType="textPersonName" android:singleLine="true" android:textColor="@color/campus_text" android:textColorHint="#52616B" android:autofillHints="name"/>
<EditText android:id="@+id/authEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginBottom="12dp" android:hint="@string/email" android:inputType="textEmailAddress" android:singleLine="true" android:textColor="@color/campus_text" android:textColorHint="#52616B" android:autofillHints="emailAddress"/>
<EditText android:id="@+id/authPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginBottom="12dp" android:hint="@string/password" android:inputType="textPassword" android:singleLine="true" android:textColor="@color/campus_text" android:textColorHint="#52616B" android:importantForAutofill="no"/>
<EditText android:id="@+id/authConfirmation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginBottom="12dp" android:hint="@string/confirm_password" android:inputType="textPassword" android:singleLine="true" android:textColor="@color/campus_text" android:textColorHint="#52616B" android:importantForAutofill="no"/>
<TextView android:id="@+id/authError" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/auth_failed" android:textSize="16sp" android:textColor="@color/campus_text" android:paddingBottom="12dp" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
<ProgressBar android:id="@+id/authProgress" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center_horizontal" android:contentDescription="@string/loading" android:visibility="gone"/>
<Button android:id="@+id/authSubmit" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/login_title" android:layout_marginTop="8dp"/>
<Button android:id="@+id/authSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/switch_register" android:layout_marginTop="8dp"/>
<TextView android:id="@+id/authDemo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/demo_accounts" android:textSize="14sp" android:textColor="@color/campus_text" android:paddingBottom="12dp" android:layout_marginTop="24dp"/>
</LinearLayout></ScrollView>
