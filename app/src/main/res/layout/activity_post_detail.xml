<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/cs_bg">

    <!-- Figma 16:398, top-app-bar 64dp. No large blue page title. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:elevation="1dp">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white_border"
            android:src="@drawable/post_ic_back"
            android:contentDescription="Quay lại"
            android:padding="10dp"
            android:scaleType="fitCenter" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white_border"
            android:src="@drawable/cs_detail_ic_share"
            android:contentDescription="Chia sẻ"
            android:padding="10dp"
            android:scaleType="fitCenter" />
        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_white_border"
            android:src="@drawable/cs_detail_ic_heart_outline"
            android:contentDescription="Yêu thích"
            android:padding="10dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- Figma hero-media-gallery: 380 x 248, radius 24. Dynamic photo. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="248dp">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">
                    <ImageView
                        android:id="@+id/imgPostDetail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Ảnh món đồ"
                        android:background="@color/border_gray"
                        android:scaleType="centerCrop" />
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:id="@+id/tvGalleryIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="9dp"
                    android:background="@drawable/cs_detail_gallery_counter"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="1 / 3"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Figma main-information-card: status then giveaway, title, chips. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="199dp"
                android:background="@drawable/cs_detail_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/tvStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/cs_edit_green_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:includeFontPadding="false"
                        android:text="AVAILABLE (CÒN ĐỒ)"
                        android:textColor="@color/status_green"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvTypeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/cs_edit_green_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:includeFontPadding="false"
                        android:text="0đ GIVE_AWAY (CHO TẶNG)"
                        android:textColor="@color/status_green"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Sách Giáo Trình Giải Tích 1 - ĐHBK &amp; ĐHSPKT"
                    android:textColor="@color/primary_blue"
                    android:textSize="20sp"
                    android:lineSpacingExtra="4dp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/cs_edit_gray_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:includeFontPadding="false"
                    android:text="Tình trạng: Mới 90%"
                    android:textColor="@color/cs_detail_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/cs_edit_gray_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:includeFontPadding="false"
                        android:text="Giáo trình ĐH"
                        android:textColor="@color/cs_detail_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvPostTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/cs_edit_gray_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:includeFontPadding="false"
                        android:text="Đăng 2 giờ trước"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Figma poster-profile-card: separate 90dp card. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="90dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/cs_detail_card"
                android:elevation="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">
                <TextView
                    android:id="@+id/tvOwnerInitial"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/cs_detail_avatar"
                    android:gravity="center"
                    android:text="TMA"
                    android:textColor="@color/primary_blue"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvOwnerName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Trần Minh Anh (K24 - Khoa Điện tử)"
                            android:textColor="@color/primary_blue"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvOwnerVerified"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/cs_edit_green_pill"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:includeFontPadding="false"
                            android:text="Xác minh sinh viên"
                            android:textColor="@color/status_green"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>
                    <!-- Keep legacy ID for View Binding; name and class render together above. -->
                    <TextView
                        android:id="@+id/tvOwnerClass"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/tvOwnerRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="4.9 (12)"
                        android:textColor="@color/status_green"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Figma item-description-section: description and pickup location. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="181dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/cs_detail_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mô tả chi tiết"
                    android:textColor="@color/primary_blue"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="5dp"
                    android:text="Sách mình học xong kỳ trước, bìa còn bọc nilon cẩn thận, không viết bút dạ quang."
                    android:textColor="@color/cs_detail_muted"
                    android:textSize="14sp" />
                <LinearLayout
                    android:id="@+id/layoutExchangeBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/cs_detail_exchange_box"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Món đồ mong muốn trao đổi:"
                        android:textColor="@color/primary_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvExchangeNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/cs_detail_muted"
                        android:textSize="13sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="top"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/cs_edit_map_pin"
                        android:contentDescription="Địa điểm nhận" />
                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="10dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:text="Địa điểm nhận"
                        android:textColor="@color/cs_detail_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvRequestStatusBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/cs_detail_exchange_box"
                android:padding="12dp"
                android:text="Yêu cầu đang chờ duyệt"
                android:textColor="@color/primary_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Figma sticky-bottom-action-bar 84dp, 380 x 48 pill. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSecondaryAction"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Hủy yêu cầu"
            android:textAllCaps="false"
            android:textColor="@color/status_red"
            android:textSize="12sp"
            android:visibility="gone"
            app:cornerRadius="24dp"
            app:strokeColor="@color/status_red" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimaryAction"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="GỬI YÊU CẦU NHẬN ĐỒ"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="24dp"
            app:icon="@drawable/cs_detail_ic_send"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />
    </LinearLayout>
</LinearLayout>
