<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/campus_background" android:fillViewport="true" android:fitsSystemWindows="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:id="@+id/profileTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_title" android:textSize="26sp" android:textColor="@color/campus_text" android:paddingBottom="12dp" android:textStyle="bold"/>
<TextView android:id="@+id/profileIntro" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_intro" android:textSize="16sp" android:textColor="@color/campus_text" android:paddingBottom="12dp" />
<TextView android:id="@+id/profileEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/email" android:textSize="16sp" android:textColor="@color/campus_text" android:paddingBottom="12dp" />
<TextView android:id="@+id/profileId" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_title" android:textSize="14sp" android:textColor="@color/campus_text" android:paddingBottom="12dp" />
<EditText android:id="@+id/profileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginBottom="12dp" android:hint="@string/full_name" android:inputType="textPersonName" android:singleLine="true" android:textColor="@color/campus_text" android:textColorHint="#52616B" android:autofillHints="name"/>
<TextView android:id="@+id/profileMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_saved" android:textSize="16sp" android:textColor="@color/campus_text" android:paddingBottom="12dp" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
<ProgressBar android:id="@+id/profileProgress" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center_horizontal" android:contentDescription="@string/loading" android:visibility="gone"/>
<Button android:id="@+id/profileSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/save_profile" android:layout_marginTop="8dp"/>
<Button android:id="@+id/profileLogout" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/logout" android:layout_marginTop="8dp"/>
<Button android:id="@+id/profileBack" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/back_home" android:layout_marginTop="8dp"/>
</LinearLayout></ScrollView>
