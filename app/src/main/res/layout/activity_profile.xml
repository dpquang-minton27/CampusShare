<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/campus_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/profileTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/profile_title"
            android:textSize="26sp" android:textStyle="bold" android:paddingBottom="12dp" />
        <TextView android:id="@+id/profileIntro" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/profile_intro"
            android:paddingBottom="12dp" />
        <TextView android:id="@+id/profileEmail" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/email" />
        <TextView android:id="@+id/profileId" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingBottom="12dp" />
        <EditText android:id="@+id/profileName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:hint="@string/full_name" android:inputType="textPersonName"
            android:autofillHints="name" android:singleLine="true" />
        <EditText android:id="@+id/profilePhone" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:hint="@string/phone_optional" android:inputType="phone" android:singleLine="true" />
        <EditText android:id="@+id/profileZalo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:hint="@string/zalo_optional" android:inputType="textUri" android:singleLine="true" />
        <TextView android:id="@+id/profilePrivacy" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/profile_privacy"
            android:paddingBottom="12dp" />
        <TextView android:id="@+id/profileVerifyStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/email_unverified" />
        <Button android:id="@+id/profileSendVerification" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/send_verification" />
        <Button android:id="@+id/profileCheckVerification" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/check_verification" />
        <TextView android:id="@+id/profileMessage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:visibility="gone"
            android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/profileProgress" android:layout_width="40dp"
            android:layout_height="40dp" android:layout_gravity="center_horizontal"
            android:contentDescription="@string/loading" android:visibility="gone" />
        <Button android:id="@+id/profileSave" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/save_profile" />
        <Button android:id="@+id/profileLogout" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/logout" />
        <Button android:id="@+id/profileBack" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/back_home" />
    </LinearLayout>
</ScrollView>
