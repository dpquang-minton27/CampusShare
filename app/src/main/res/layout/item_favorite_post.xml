<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="19dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="false"
    app:strokeColor="@color/border_gray"
    app:strokeWidth="1dp">

    <!-- Figma 39:159, 380x135dp. Can grow vertically with font scaling. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="135dp">

        <ImageView
            android:id="@+id/imgFavPost"
            android:layout_width="100dp"
            android:layout_height="107dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/fav_thumbnail_bg"
            android:clipToOutline="true"
            android:contentDescription="@string/fav_image_description"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvFavStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/fav_badge_status"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="AVAILABLE"
            android:textColor="@color/status_green"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/imgFavPost"
            app:layout_constraintTop_toTopOf="@id/imgFavPost" />

        <TextView
            android:id="@+id/tvFavTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/primary_blue"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgFavPost"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/favBadgesRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/tvFavTitle"
            app:layout_constraintStart_toStartOf="@id/tvFavTitle"
            app:layout_constraintTop_toBottomOf="@id/tvFavTitle">

            <TextView
                android:id="@+id/tvFavPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fav_badge_price"
                android:includeFontPadding="false"
                android:minWidth="33dp"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:text="@string/fav_zero_price"
                android:textColor="@color/fav_type_text"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvFavType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/fav_badge_type"
                android:includeFontPadding="false"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="GIVE_AWAY"
                android:textColor="@color/fav_type_text"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFavCondition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="@id/tvFavTitle"
            app:layout_constraintStart_toStartOf="@id/tvFavTitle"
            app:layout_constraintTop_toBottomOf="@id/favBadgesRow" />

        <TextView
            android:id="@+id/tvFavOwner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="@id/tvFavTitle"
            app:layout_constraintStart_toStartOf="@id/tvFavTitle"
            app:layout_constraintTop_toBottomOf="@id/tvFavCondition" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFavRequest"
            android:layout_width="110dp"
            android:layout_height="28dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            android:backgroundTint="@color/primary_blue"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/fav_request"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFavOwner"
            app:layout_constraintVertical_bias="1" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
