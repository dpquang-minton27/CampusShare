<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Phần trên: Ảnh bo góc + Tiêu đề + Nhãn hình thức + Trạng thái + Ngày đăng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="78dp"
                android:layout_height="78dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgPost"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/border_gray"
                    android:contentDescription="Ảnh món đồ"
                    android:scaleType="centerCrop" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Dòng 1: Tên món đồ + Nhãn 0đ GIVE_AWAY / TRAO ĐỔI EXCHANGE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Sách Giải Tích 1"
                        android:textColor="@color/primary_blue"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTypeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="0đ GIVE_AWAY"
                        android:textColor="@color/status_green"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Dòng 2: Nhãn AVAILABLE + Ngày đăng -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="AVAILABLE"
                        android:textColor="@color/status_green"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCreatedDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Ngày đăng: Hôm nay"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Dòng thông báo số yêu cầu (Hiện khi bài đang AVAILABLE) -->
        <LinearLayout
            android:id="@+id/layoutRequestCountPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="@color/status_green_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Yêu cầu"
                android:src="@drawable/ic_cat_personal"
                app:tint="@color/status_green" />

            <TextView
                android:id="@+id/tvRequestSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="3 yêu cầu nhận đồ"
                android:textColor="@color/status_green"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dòng thông tin người đã nhận (Hiện khi bài ĐÃ HOÀN TẤT) -->
        <TextView
            android:id="@+id/tvCompletedRecipient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Đã trao cho bạn Nguyễn Văn A"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Cụm 3 nút hành động khi bài đang AVAILABLE: Xem yêu cầu + Sửa tin + Xóa -->
        <LinearLayout
            android:id="@+id/layoutActiveButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewRequests"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1.5"
                android:backgroundTint="@color/primary_blue"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Xem yêu cầu (0)"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditPost"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Sửa tin"
                android:textAllCaps="false"
                android:textColor="@color/primary_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:strokeColor="@color/border_gray" />

            <ImageButton
                android:id="@+id/btnDeletePost"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_white_border"
                android:contentDescription="Xóa tin"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/status_red" />
        </LinearLayout>

        <!-- Nút xám Đã kết thúc (Hiện khi bài ĐÃ HOÀN TẤT) -->
        <TextView
            android:id="@+id/btnFinishedBadge"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="#EEF2F6"
            android:gravity="center"
            android:text="Đã kết thúc"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
