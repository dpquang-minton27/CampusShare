<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Thông tin món đồ + đối tác -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgPostThumb"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@color/border_gray"
                android:contentDescription="Ảnh món đồ"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPostTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Tên món đồ"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCounterpartInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Người đăng: Trần Minh Anh"
                    android:textColor="@color/primary_blue"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Lời nhắn -->
        <TextView
            android:id="@+id/tvRequestMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/bg_screen"
            android:padding="10dp"
            android:text="Lời nhắn nguyện vọng..."
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <!-- Thanh tiến trình 3 bước chuẩn Figma: Đã gửi -> Đang duyệt -> Kết quả -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStep1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="1. Đã gửi"
                android:textColor="@color/status_green"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/lineStep12"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="@color/status_green" />

            <TextView
                android:id="@+id/tvStep2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="2. Đang duyệt"
                android:textColor="@color/primary_blue"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/lineStep23"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="@color/border_gray" />

            <TextView
                android:id="@+id/tvStep3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/bg_screen"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="3. Chờ kết quả"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cụm nút duyệt cho Chủ bài đăng -->
        <LinearLayout
            android:id="@+id/layoutOwnerActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReject"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Từ chối"
                android:textColor="@color/status_red"
                android:textSize="12sp"
                app:strokeColor="@color/status_red" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccept"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:backgroundTint="@color/status_green"
                android:text="Chấp nhận tặng/đổi"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nút Hủy yêu cầu (khi đang PENDING ở tab Đã gửi) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelRequest"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:text="Hủy yêu cầu"
            android:textColor="@color/status_red"
            android:textSize="12sp"
            android:visibility="gone"
            app:strokeColor="@color/status_red" />

        <!-- Nút Liên hệ SĐT / Zalo (khi ACCEPTED) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContactPartner"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/primary_blue"
            android:text="Liên hệ SĐT / Zalo nhận đồ"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>