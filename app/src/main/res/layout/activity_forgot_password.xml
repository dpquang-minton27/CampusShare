<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <!-- Header Logo & Tên Trường -->
        <androidx.cardview.widget.CardView
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="32dp"
            app:cardElevation="3dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Logo UTE"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_ute" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ĐẠI HỌC SƯ PHẠM KỸ THUẬT - ĐH ĐÀ NẴNG"
            android:textColor="@color/primary_blue"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="CampusShare"
            android:textColor="@color/primary_blue"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Chia sẻ đồ dùng – Kết nối sinh viên"
            android:textColor="@color/primary_blue"
            android:textSize="12sp"
            android:textStyle="italic" />

        <!-- Thẻ trắng chính chứa 2 bước: Nhập thông tin & Xác thực OTP -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="26dp">

                <!-- BƯỚC 1: NHẬP MSSV/EMAIL & MẬT KHẨU MỚI -->
                <LinearLayout
                    android:id="@+id/layoutStep1Forgot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Quên Mật Khẩu"
                        android:textColor="@color/primary_blue"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="Nhập Email Sinh Viên UTE của bạn để nhận mã xác nhận (OTP) hoặc liên kết đặt lại mật khẩu mới"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Ô nhập Mã số sinh viên / Email -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="Mã số sinh viên (MSSV)"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:startIconDrawable="@drawable/ic_menu_sent_req">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtStudentIdOrEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Ô nhập Mật khẩu mới -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Mật khẩu mới"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@android:drawable/ic_lock_idle_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNewPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Ô nhập Xác nhận mật khẩu -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Xác nhận mật khẩu"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@android:drawable/ic_lock_idle_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="*Chỉ áp dụng cho tài khoản email trường"
                        android:textColor="@color/status_green"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendOtp"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/primary_blue"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="GỬI MÃ XÁC NHẬN"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="24dp" />
                </LinearLayout>

                <!-- BƯỚC 2: XÁC THỰC OTP 6 CHỮ SỐ -->
                <LinearLayout
                    android:id="@+id/layoutStep2Otp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xác Thực OTP"
                        android:textColor="@color/primary_blue"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Nhập mã 6 chữ số vừa gửi đến\nemail của bạn"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMaskedEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="2415141******@sv.ute.udn.vn"
                        android:textColor="#5B8DEF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- 6 Ô nhập mã OTP -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/edtOtp1"
                            android:layout_width="40dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_otp_box"
                            android:gravity="center"
                            android:hint="-"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/primary_blue"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtOtp2"
                            android:layout_width="40dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_otp_box"
                            android:gravity="center"
                            android:hint="-"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/primary_blue"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtOtp3"
                            android:layout_width="40dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_otp_box"
                            android:gravity="center"
                            android:hint="-"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/primary_blue"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtOtp4"
                            android:layout_width="40dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_otp_box"
                            android:gravity="center"
                            android:hint="-"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/primary_blue"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtOtp5"
                            android:layout_width="40dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_otp_box"
                            android:gravity="center"
                            android:hint="-"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/primary_blue"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtOtp6"
                            android:layout_width="40dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_otp_box"
                            android:gravity="center"
                            android:hint="-"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="@color/primary_blue"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Dòng đếm ngược & Gửi lại mã -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chưa nhập được mã ? "
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvResendOtp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gửi lại (00:45)"
                            android:textColor="#5B8DEF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Nút Quay lại dưới cùng -->
        <TextView
            android:id="@+id/tvBackAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="8dp"
            android:text="← Quay lại Đăng nhập"
            android:textColor="@color/status_green"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
