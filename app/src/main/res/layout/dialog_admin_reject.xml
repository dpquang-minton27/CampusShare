<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="22dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Lý Do Gỡ / Từ Chối Bài Đăng"
            android:textColor="@color/primary_blue"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRejectSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Chọn hoặc nhập lý do gửi thông báo đến sinh viên:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/rgRejectReasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <RadioButton
                android:id="@+id/rbReason1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Hình ảnh mờ hoặc không đúng thực tế"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbReason2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Món đồ không phù hợp quy định sinh viên"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbReason3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trùng lặp bài đăng đã có trên hệ thống"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </RadioGroup>

        <EditText
            android:id="@+id/edtCustomReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_outline"
            android:hint="Nhập ghi chú thêm (không bắt buộc)..."
            android:minLines="2"
            android:padding="12dp"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelReject"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Hủy"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                app:cornerRadius="21dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmReject"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:backgroundTint="#DC2626"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Xác nhận gỡ"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="21dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
